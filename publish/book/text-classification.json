ey":"GON93l5uxy"},{"type":"tableCell","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"add a description","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"LfbPAcT0zo"}],"key":"FD9lT1Daiy"}],"key":"qkZyHZKpJq"},{"type":"tableRow","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Prompt to Claude Haiku 5.5","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"T1hHvRZObd"}],"key":"ZL50Q2E9i0"},{"type":"tableCell","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"none","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"GUVeIO6JGd"}],"key":"FCydbqqFbE"},{"type":"tableCell","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"75.1%","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"oFwoMfjB4D"}],"key":"TptLXeaqU6"},{"type":"tableCell","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"1.7 s per tweet; $0.10 for 2,000 tweets","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"CNeGgtMsxo"}],"key":"wKlGGDZR6n"},{"type":"tableCell","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"change the prompt","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"nzgrukEn4y"}],"key":"XKxML3S3yq"}],"key":"ZS2DyDaBuK"},{"type":"tableRow","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"tableCell","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Prompt to Claude Sonnet 5.5","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"dCnyyQ2gGy"}],"key":"wTUuoy7b8r"},{"type":"tableCell","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"none","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"ZsFjd8AEZ8"}],"key":"uXInBK6iwU"},{"type":"tableCell","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"79.1%","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"cg2NdQj4ox"}],"key":"CZHWi5a6dL"},{"type":"tableCell","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"2.1 s per tweet; $2.25 for 2,000 tweets","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"ZNSg8ENqvN"}],"key":"qwtY6f6Mnl"},{"type":"tableCell","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"change the prompt","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"mKyMzbmgcz"}],"key":"Rh7bEJSx1K"}],"key":"AgJDFDV243"}],"key":"RjXXgSpemA"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"The comparison is above all a lesson in Occam’s razor (","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"TytjffTf2d"},{"type":"link","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Over- and Underfitting","key":"YteoxMMZjy"}],"identifier":"appendix-overfitting","label":"appendix-overfitting","url":"/over-and-underfitting","internal":true,"dataUrl":"/over-and-underfitting.json","key":"EWQC3SSkgu"},{"type":"text","value":"): among methods of similar accuracy, choose the simplest. Naive Bayes, the frozen encoder, and the prompt to Sonnet all reach 79%. The fine-tuned encoder is only four points ahead, a gap that can shrink or grow on other tweets and with labels that people assigned instead of emoticons. The costs, however, differ by orders of magnitude. Naive Bayes trains in 64 milliseconds and classifies a tweet in about 7 microseconds on a laptop. Fine-tuning takes about 3,000 times longer to train, and a prompt to Sonnet takes about 2 seconds per tweet, some 300,000 times longer, and costs about $1,100 per million tweets. A method that costs this much more has to earn its place with a clear gain on the task at hand.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"PTpZzGK5WM"}],"key":"OUUUpSmbEE"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"This suggests an order of work. Start with a fast baseline such as Naive Bayes or logistic regression, and look at its most informative features to check the labels. Use embeddings with a linear probe when one encoder should serve several tasks. Fine-tune when the extra accuracy matters and labeled data exists. Use zero-shot prototypes or prompts when there are no labels, when the classes change often, or when the hard cases need an understanding of context that only a large model brings. And whichever method wins, the accuracy is only as meaningful as the labels it is measured against.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"ofWyi6OzII"}],"key":"RyQw4aNwyO"}],"key":"DiZSTlQtFo"}],"key":"hOFLlole6A"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Fine-Tuning","url":"/fine-tuning","group":"Appendix (Optional Reading)"},"next":{"title":"Generative Language Models","url":"/generative-language-models","group":"Appendix (Optional Reading)"}}},"domain":"http://localhost:3000"}