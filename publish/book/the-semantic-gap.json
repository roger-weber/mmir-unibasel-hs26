ition":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Features.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"P2RHrlatlV"}],"key":"OYEatfh1Dt"},{"type":"text","value":" Compute perceptual features that describe how the content looks or sounds, and compare items by feature similarity, for example “find images with similar colors”. Classifiers turn features into labels such as “person” or “outdoor”, which feed back into the keyword path. ","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"YXj1QBEgeJ"},{"type":"link","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"Automated Feature Extraction","key":"eXnfzf12IX"}],"identifier":"content-analysis-feature-extraction","label":"content-analysis-feature-extraction","url":"/automated-feature-extraction","internal":true,"dataUrl":"/automated-feature-extraction.json","key":"yIC3fORD2Q"},{"type":"text","value":" introduces this level.","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"zAbTJFoWTO"}],"key":"bnFf5TKdN7"}],"key":"VBv1rGseQd"},{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Transformers.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"n34ir1HeQ8"}],"key":"WlLpZzqJDr"},{"type":"text","value":" Multimodal transformers either generate a rich description of the content, which again feeds the keyword path, or map media and text into a shared embedding space, so that a text query can be compared directly with an image. ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"CIMABpWPuf"},{"type":"link","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Multimodal Transformers","key":"NQOhn4lexK"}],"identifier":"content-analysis-transformers","label":"content-analysis-transformers","url":"/multimodal-transformers","internal":true,"dataUrl":"/multimodal-transformers.json","key":"Scj6svCLtE"},{"type":"text","value":" explains both options.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"H9TF134aHK"}],"key":"X96X4HvYK9"}],"key":"PWTzmdueJA"}],"key":"wLV2w3zQJe"},{"type":"paragraph","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Audio and video add time, and some tasks need specialized solutions. ","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"menIB3iUSj"},{"type":"link","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Time-Based Media and Specialized Solutions","key":"JEzj7CzZPc"}],"identifier":"content-analysis-time-specialized","label":"content-analysis-time-specialized","url":"/time-and-specialized-solutions","internal":true,"dataUrl":"/time-and-specialized-solutions.json","key":"bVHHev3NbA"},{"type":"text","value":" covers both. The remaining chapters of this part then work out the perceptual features for images, audio, and video in detail.","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"dUwfYiReyA"}],"key":"HcrfLM5uNY"}],"key":"tCc2YgMnol"}],"key":"eeGEqisB6a"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"9 - Content Analysis & Metadata","url":"/index-9","group":"Part III: Web & Multimodal"},"next":{"title":"Metadata and Its Limits","url":"/metadata-and-its-limits","group":"Part III: Web & Multimodal"}}},"domain":"http://localhost:3000"}