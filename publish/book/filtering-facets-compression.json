s), keeping data byte-aligned for fast decoding and reaching roughly 15 to 20 percent of the uncompressed size.","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"E7hMgvnRG1"}],"key":"vkI1gMHWzy"},{"type":"heading","depth":2,"position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Metadata alongside postings","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"mwXvRdVUzP"}],"identifier":"metadata-alongside-postings","label":"Metadata alongside postings","html_id":"metadata-alongside-postings","implicit":true,"key":"EIOmzh10p5"},{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Modern indexes store more than document identifiers in a postings list, and the same compression applies to the extra data. ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"MCTT2nel2f"},{"type":"strong","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Term frequencies","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"CMsbNEzlT0"}],"key":"zXTlC8OzWR"},{"type":"text","value":" are written as small integers after each identifier, enabling TF-IDF and BM25 scoring. Because BM25’s saturation function flattens the contribution of high term frequencies, values above a modest ceiling barely affect the score. This means term frequencies can be capped and encoded in just a few bits (four bits suffice in practice) without noticeably hurting retrieval accuracy. ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"TNAh7bRrnk"},{"type":"strong","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"Length-normalization data","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"C9cxIebWzQ"}],"k